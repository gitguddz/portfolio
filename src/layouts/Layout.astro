---
import NavBar from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'My portfolio site', lang = 'en' } = Astro.props as Props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<script is:inline>
			document.documentElement.lang = localStorage.getItem("lang") || "en";
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500&display=swap" rel="stylesheet" />
	</head>
	<body class="intro">
		<div class="cursor-circle" id="cursor-circle"></div>
		<NavBar />
		<main>
			<slot/>
		</main>
	</body>
</html>

<script>
	import Lenis from "lenis";

	// ── Custom cursor ─────────────────────────────────────────────────
	const circle = document.getElementById("cursor-circle")!;
	let cx = 0, cy = 0, tx = 0, ty = 0;
	let cursorVisible = false;

	window.addEventListener("mousemove", (e) => {
		tx = e.clientX;
		ty = e.clientY;
		if (!cursorVisible) {
			circle.style.opacity = "1";
			cursorVisible = true;
		}
	});

	document.documentElement.addEventListener("mouseleave", () => {
		circle.style.opacity = "0";
		cursorVisible = false;
	});

	function moveCursor() {
		cx += (tx - cx) * 0.5;
		cy += (ty - cy) * 0.5;
		circle.style.transform = `translate(${cx}px, ${cy}px)`;
		requestAnimationFrame(moveCursor);
	}
	moveCursor();

	// Hide circle over iframes but keep position synced
	let overIframe = false;

	document.querySelectorAll(".project-video").forEach((wrap) => {
		wrap.addEventListener("mouseenter", () => {
			overIframe = true;
			circle.style.opacity = "0";
		});
		wrap.addEventListener("mouseleave", (e) => {
			overIframe = false;
			cx = (e as MouseEvent).clientX;
			cy = (e as MouseEvent).clientY;
			tx = cx;
			ty = cy;
			circle.style.transform = `translate(${cx}px, ${cy}px)`;
			circle.style.opacity = "1";
		});
	});

	// Grow cursor on hoverable text
	const hoverTargets = "a, button, .chip, .nav-link, .mobile-nav-link, h1, h2, p, span";
	document.addEventListener("mouseover", (e) => {
		if ((e.target as HTMLElement).closest(hoverTargets)) {
			circle.classList.add("cursor-hover");
		}
	});
	document.addEventListener("mouseout", (e) => {
		if ((e.target as HTMLElement).closest(hoverTargets)) {
			circle.classList.remove("cursor-hover");
		}
	});

	const lenis = new Lenis({
		duration: 1.2,
		easing: (t: number) => 1 - Math.pow(1 - t, 4),
		smoothWheel: true,
		touchMultiplier: 1.5,
		wheelMultiplier: 0.8,
	});

	function raf(time: number) {
		lenis.raf(time);
		requestAnimationFrame(raf);
	}
	requestAnimationFrame(raf);

	// ── Nav hide/show on scroll ──────────────────────────────────────
	const header = document.querySelector("header")!;
	let lastScroll = 0;
	let navHidden = false;

	const isMobile = window.matchMedia("(max-width: 767px)");

	window.addEventListener("scroll", () => {
		const y = window.scrollY;
		if (y < 100) {
			header.classList.remove("nav-hidden");
			navHidden = false;
		} else if (y > lastScroll && !navHidden) {
			header.classList.add("nav-hidden");
			navHidden = true;
		} else if (y < lastScroll && navHidden && isMobile.matches) {
			header.classList.remove("nav-hidden");
			navHidden = false;
		}
		lastScroll = y;
	}, { passive: true });


	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
		anchor.addEventListener("click", (e) => {
			const id = anchor.getAttribute("href");
			if (!id || id === "#") return;
			const target = document.querySelector(id);
			if (!target) return;
			e.preventDefault();
			const offset = id === "#about" ? window.innerHeight * 0.75 : 0;
			lenis.scrollTo(target as HTMLElement, { offset, duration: 2 });
		});
	});

	const body = document.body;
	const skipIntro = sessionStorage.getItem("skip-intro");

	if (skipIntro) {
		sessionStorage.removeItem("skip-intro");
		body.classList.remove("intro");
	} else {
		setTimeout(() => {
			body.classList.add("intro-step-1");
		}, 300);

		setTimeout(() => {
			body.classList.add("intro-step-2");
		}, 1200);

		setTimeout(() => {
			body.classList.remove("intro", "intro-step-1", "intro-step-2");
		}, 2200);
	}
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
