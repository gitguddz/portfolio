  {
    id: "3oVf5oVtqTs?si=ORZ3huwbjTQu8j1u",
    title: "Wanedo — Pozione",
    desc: "Shot by me, edited by me & Wanedo.",
  },
  {
    id: "y2OoGlplzxI?si=IFovXCywAerX5LJm",
    title: "Big Neiya x SCS bando — CRAZY LEAN CUP (DJ Nelo remix)",
    desc: "Shot & edited by me.",
  },
  {
    id: "TYojLfhZbak?si=v7Cwlh4a9ZJWU04J",
    title: "to look up when there's nothing left to climb",
    desc: "Shot by me & GOSHA, edited by GOSHA (Jakub Beyger).",
  },
  {
    id: "bl3Ecbjab9U?si=4G9m01wGEKkzMJv8",
    title: "The Answer is Not a Small Hut in Poland",
    desc: "Shot by me, edited by GOSHA (Jakub Beyger).",
  },
];
---

<section id="projects" class="border-t border-foreground px-6 md:px-10">
  <div class="flex items-baseline justify-between py-5">
    <span class="font-mono text-[11px] uppercase tracking-[0.28em]">Selected Work</span>
    <span class="font-mono text-[11px] uppercase tracking-[0.28em]">Video</span>
  </div>

  <div class="grid grid-cols-1 gap-x-10 gap-y-16 pb-32 md:grid-cols-2 md:gap-y-20 md:pb-48">
    {projects.map((p) => (
      <figure>
        <div class="aspect-video w-full overflow-hidden bg-foreground/5">
          <iframe
            src={`https://www.youtube.com/embed/${p.id}`}
            title={p.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="h-full w-full"
          ></iframe>
        </div>
        <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-2 border-t border-foreground pt-3">
          <span class="display text-lg uppercase">{p.title}</span>
          <span class="font-mono text-[11px] uppercase tracking-[0.14em]">{p.desc}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
