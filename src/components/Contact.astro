---
const links = [
  { label: "Email", value: "sabriak60@gmail.com", href: "mailto:sabriak60@gmail.com" },
  { label: "Instagram", value: "@sabrii.akbas", href: "https://www.instagram.com/sabrii.akbas" },
  { label: "Instagram (film)", value: "@eeth5r", href: "https://www.instagram.com/eeth5r" },
  { label: "YouTube", value: "@eeth5r", href: "https://youtube.com/@eeth5r?si=RnjTgt1068Ssp-ru" },
  { label: "LinkedIn", value: "Sabri Akbas", href: "https://www.linkedin.com/in/sabri-akbas-4b887630a" },
  { label: "GitHub", value: "gitguddz", href: "https://github.com/gitguddz" },
];
---

<section id="contact" class="border-t border-foreground px-6 py-20 md:px-10 md:py-32">
  <p class="display text-4xl leading-[0.9] md:text-6xl">
    LET'S
    <br />
    TALK
  </p>
  <p class="mt-6 max-w-sm font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
    Have a project in mind? Reach out through any of the channels below.
  </p>

  <div class="mt-12 grid grid-cols-1 font-mono text-[11px] uppercase tracking-[0.14em] md:grid-cols-2 md:text-xs">
    {links.map((link, i) => (
      <a
        href={link.href}
        target={link.href.startsWith("http") ? "_blank" : undefined}
        rel={link.href.startsWith("http") ? "noopener" : undefined}
        class={`flex items-baseline justify-between gap-4 border-t border-foreground py-4 hover:opacity-50 ${i % 2 === 0 ? "md:pr-8" : "md:pl-8"}`}
      >
        <span>{link.label}</span>
        <span class="text-muted-foreground">{link.value}</span>
      </a>
    ))}
  </div>
</section>
