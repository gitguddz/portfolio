---
const items = [
  {
    number: "01",
    title: "About Me",
    text: "Developer and filmmaker based in Lugano. I blend technology with visual storytelling to create experiences that stand out.",
    image: { src: "/me.webp", alt: "Sabri Akbas", width: 702, height: 800 },
  },
  {
    number: "02",
    title: "What I Do",
    text: "From building performant web applications to directing music videos and cinematic content — I work across both worlds.",
    video: true,
  },
  {
    number: "03",
    title: "Tools & Craft",
    text: "Java, Spring, Docker, React, TypeScript and more on the dev side. DaVinci Resolve, Premiere Pro, After Effects and cinema cameras on the creative side.",
    image: { src: "/desk.webp", alt: "Tools & craft", width: 800, height: 538 },
  },
  {
    number: "04",
    title: "Philosophy",
    text: "Every detail matters. Whether it's code or a frame — precision, intention, and taste drive everything I make.",
    image: { src: "/moto.webp", alt: "Philosophy", width: 1200, height: 675 },
  },
];
---

<section id="about" class="border-t border-foreground px-6 md:px-10">
  <div class="flex items-baseline justify-between py-5">
    <span class="font-mono text-[11px] uppercase tracking-[0.28em]">About</span>
    <span class="font-mono text-[11px] uppercase tracking-[0.28em]">01 &mdash; 04</span>
  </div>

  <div class="grid grid-cols-1 gap-x-10 gap-y-20 pb-32 md:grid-cols-2 md:gap-y-32 md:pb-48">
    {items.map((item) => (
      <figure>
        {item.video ? (
          <div class="about-video-wrap relative aspect-[4/5] w-full overflow-hidden bg-foreground/5">
            <video
              class="h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              disablepictureinpicture
              preload="metadata"
            >
              <source src="/j4n.mp4" type="video/mp4" />
            </video>
            <button
              class="about-mute-btn absolute bottom-3 right-3 border border-background bg-foreground px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-background"
              type="button"
              aria-label="Toggle video sound"
            >
              Unmute
            </button>
          </div>
        ) : (
          <div class="aspect-[4/5] w-full overflow-hidden bg-foreground/5">
            <img
              src={item.image!.src}
              alt={item.image!.alt}
              width={item.image!.width}
              height={item.image!.height}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        )}
        <figcaption class="mt-4 border-t border-foreground pt-3">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-mono text-[11px] uppercase tracking-[0.28em] text-muted-foreground">
              {item.number}
            </span>
            <span class="display text-lg uppercase">{item.title}</span>
          </div>
          <p class="mt-3 font-mono text-[11px] leading-[1.9] uppercase tracking-[0.14em]">
            {item.text}
          </p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>(".about-video-wrap video");
  const muteBtn = document.querySelector<HTMLButtonElement>(".about-mute-btn");

  muteBtn?.addEventListener("click", () => {
    if (!video) return;
    video.muted = !video.muted;
    muteBtn.textContent = video.muted ? "Unmute" : "Mute";
  });
</script>
