---
import translations, { type Lang } from "../i18n/translations";
---

<script is:inline define:vars={{ translations }}>
  window.__heroTranslations = translations;
</script>

<section id="home" class="hero">
  <div class="hero-shapes" aria-hidden="true">
    <div class="shape shape--1"></div>
    <div class="shape shape--2"></div>
    <div class="shape shape--3"></div>
    <div class="shape shape--4"></div>
    <div class="shape shape--5"></div>
  </div>
  <div class="hero-content">
    <h1 class="hero-title">
      <span class="hero-static" id="hero-where">where </span><span class="hero-roller" id="roller-top"><span class="roller-track" id="track-top"></span></span>
      <br />
      <span class="hero-static" id="hero-finds">finds </span><span class="hero-roller" id="roller-bottom"><span class="roller-track" id="track-bottom"></span></span>
    </h1>
  </div>
</section>

<script>
  const hero = document.querySelector(".hero") as HTMLElement;
  const shapes = document.querySelectorAll<HTMLElement>(".shape");

  const strengths = [0.03, 0.05, 0.04, 0.025, 0.06];
  const current = Array.from(shapes, () => ({ x: 0, y: 0 }));
  const target = Array.from(shapes, () => ({ x: 0, y: 0 }));

  hero.addEventListener("mousemove", (e) => {
    const rect = hero.getBoundingClientRect();
    const cx = e.clientX - rect.left - rect.width / 2;
    const cy = e.clientY - rect.top - rect.height / 2;

    shapes.forEach((_, i) => {
      target[i].x = cx * strengths[i];
      target[i].y = cy * strengths[i];
    });
  });

  hero.addEventListener("mouseleave", () => {
    target.forEach((t) => { t.x = 0; t.y = 0; });
  });

  function tick() {
    shapes.forEach((shape, i) => {
      current[i].x += (target[i].x - current[i].x) * 0.08;
      current[i].y += (target[i].y - current[i].y) * 0.08;
      shape.style.setProperty("--mx", `${current[i].x}px`);
      shape.style.setProperty("--my", `${current[i].y}px`);
    });
    requestAnimationFrame(tick);
  }

  tick();

  // ── Slide animation ────────────────────────────────────────────────
  const trackTop = document.getElementById("track-top")!;
  const trackBottom = document.getElementById("track-bottom")!;
  const rollerTop = document.getElementById("roller-top")!;
  const rollerBottom = document.getElementById("roller-bottom")!;
  const heroWhere = document.getElementById("hero-where")!;
  const heroFinds = document.getElementById("hero-finds")!;

  const allTranslations = (window as any).__heroTranslations as Record<string, Record<string, string>>;

  function getLang(): string {
    return document.documentElement.lang || "en";
  }

  function tr(key: string): string {
    const lang = getLang();
    return allTranslations[lang]?.[key] ?? allTranslations["en"][key] ?? key;
  }

  function buildTrack(track: HTMLElement, wordsStr: string) {
    track.innerHTML = "";
    const words = wordsStr.split(",");
    words.forEach((w) => {
      const span = document.createElement("span");
      span.textContent = w;
      track.appendChild(span);
    });
  }

  function setFixedWidth(roller: HTMLElement) {
    const spans = roller.querySelectorAll<HTMLElement>(".roller-track > span");
    let maxW = 0;
    spans.forEach((s) => { maxW = Math.max(maxW, s.offsetWidth); });
    roller.style.width = `${maxW + 8}px`;
  }

  let wordCount = 5;

  function applyLangToHero() {
    heroWhere.textContent = tr("hero.where");
    heroFinds.textContent = tr("hero.finds");
    buildTrack(trackTop, tr("hero.top_words"));
    buildTrack(trackBottom, tr("hero.bottom_words"));
    wordCount = tr("hero.top_words").split(",").length - 1;
    setFixedWidth(rollerTop);
    setFixedWidth(rollerBottom);
  }

  applyLangToHero();

  window.addEventListener("lang-change", () => {
    applyLangToHero();
    trackTop.style.transition = "none";
    trackTop.style.transform = "translateY(0)";
    trackBottom.style.transition = "none";
    trackBottom.style.transform = "translateY(0)";
  });

  const stepH = rollerTop.offsetHeight;

  function slideTrack(track: HTMLElement, step: number): Promise<void> {
    return new Promise((resolve) => {
      const target = -(step * stepH);
      track.style.transition = "transform 0.9s cubic-bezier(0.4, 0, 0.2, 1)";
      track.style.transform = `translateY(${target}px)`;
      track.addEventListener("transitionend", () => resolve(), { once: true });
    });
  }

  async function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  async function stepRoller(track: HTMLElement, step: number): Promise<number> {
    step++;
    await slideTrack(track, step);
    if (step >= wordCount) {
      await sleep(50);
      track.style.transition = "none";
      track.style.transform = "translateY(0)";
      track.getBoundingClientRect();
      return 0;
    }
    return step;
  }

  async function loop() {
    let stepTop = 0;
    let stepBottom = 0;
    let flipTop = true;

    while (true) {
      if (flipTop) {
        stepTop = await stepRoller(trackTop, stepTop);
      } else {
        stepBottom = await stepRoller(trackBottom, stepBottom);
      }
      flipTop = !flipTop;
      await sleep(2000);
    }
  }

  async function waitForIntro() {
    while (document.body.classList.contains("intro")) {
      await sleep(100);
    }
  }

  waitForIntro().then(() => loop());
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 18vh;
    overflow: hidden;
  }

  /* ── Floating shapes ── */
  .hero-shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .shape {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    opacity: 1;
    --mx: 0px;
    --my: 0px;
    translate: var(--mx) var(--my);
    will-change: translate;
  }

  :global(html.dark) .shape {
    border-color: rgba(255, 255, 255, 0.15);
    opacity: 1;
  }

  .shape--1 {
    width: 320px;
    height: 320px;
    top: 10%;
    left: 8%;
    border-radius: 50%;
    animation: float-1 14s ease-in-out infinite;
  }

  .shape--2 {
    width: 180px;
    height: 180px;
    top: 55%;
    right: 12%;
    border-radius: 40%;
    animation: float-2 11s ease-in-out infinite;
  }

  .shape--3 {
    width: 100px;
    height: 100px;
    bottom: 18%;
    left: 20%;
    border-radius: 30%;
    animation: float-3 13s ease-in-out infinite;
  }

  .shape--4 {
    width: 240px;
    height: 240px;
    top: 15%;
    right: 20%;
    border-radius: 50%;
    animation: float-4 16s ease-in-out infinite;
  }

  .shape--5 {
    width: 70px;
    height: 70px;
    bottom: 30%;
    right: 35%;
    border-radius: 35%;
    animation: float-5 10s ease-in-out infinite;
  }

  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(30px, -20px) rotate(8deg); }
    50% { transform: translate(-15px, 25px) rotate(-5deg); }
    75% { transform: translate(20px, 10px) rotate(3deg); }
  }

  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(-25px, 15px) rotate(-10deg); }
    66% { transform: translate(20px, -30px) rotate(6deg); }
  }

  @keyframes float-3 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    30% { transform: translate(15px, -25px) rotate(12deg); }
    60% { transform: translate(-20px, 10px) rotate(-8deg); }
  }

  @keyframes float-4 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    20% { transform: translate(-20px, -15px) rotate(-4deg); }
    50% { transform: translate(25px, 20px) rotate(7deg); }
    80% { transform: translate(-10px, -25px) rotate(-3deg); }
  }

  @keyframes float-5 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    40% { transform: translate(20px, 20px) rotate(15deg); }
    70% { transform: translate(-15px, -10px) rotate(-10deg); }
  }

  /* ── Content ── */
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 100;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    color: #3a3a3a;
    margin: 0;
    min-height: 2.6em;
  }

  :global(html.dark) .hero-title {
    color: #c8c8c8;
  }

  .hero-roller {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: bottom;
    height: 1.3em;
    text-align: center;
    font-family: "Space Grotesk", sans-serif;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .roller-track {
    display: flex;
    flex-direction: column;
  }

  .roller-track > span {
    height: 1.3em;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--roller-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
