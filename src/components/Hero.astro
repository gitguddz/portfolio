---
---

<section id="home" class="hero">
  <div class="hero-shapes" aria-hidden="true">
    <div class="shape shape--1"></div>
    <div class="shape shape--2"></div>
    <div class="shape shape--3"></div>
    <div class="shape shape--4"></div>
    <div class="shape shape--5"></div>
  </div>
  <div class="hero-content">
    <h1 class="hero-title">
      <span class="hero-static">where </span><span class="hero-roller" id="roller-top"><span class="roller-current">code</span></span>
      <br />
      <span class="hero-static">finds </span><span class="hero-roller" id="roller-bottom"><span class="roller-current">cinema</span></span>
    </h1>
  </div>
</section>

<script>
  const hero = document.querySelector(".hero") as HTMLElement;
  const shapes = document.querySelectorAll<HTMLElement>(".shape");

  const strengths = [0.03, 0.05, 0.04, 0.025, 0.06];
  const current = Array.from(shapes, () => ({ x: 0, y: 0 }));
  const target = Array.from(shapes, () => ({ x: 0, y: 0 }));

  hero.addEventListener("mousemove", (e) => {
    const rect = hero.getBoundingClientRect();
    const cx = e.clientX - rect.left - rect.width / 2;
    const cy = e.clientY - rect.top - rect.height / 2;

    shapes.forEach((_, i) => {
      target[i].x = cx * strengths[i];
      target[i].y = cy * strengths[i];
    });
  });

  hero.addEventListener("mouseleave", () => {
    target.forEach((t) => { t.x = 0; t.y = 0; });
  });

  function tick() {
    shapes.forEach((shape, i) => {
      current[i].x += (target[i].x - current[i].x) * 0.08;
      current[i].y += (target[i].y - current[i].y) * 0.08;
      shape.style.setProperty("--mx", `${current[i].x}px`);
      shape.style.setProperty("--my", `${current[i].y}px`);
    });
    requestAnimationFrame(tick);
  }

  tick();

  // ── Slide animation ────────────────────────────────────────────────
  const rollerTop = document.getElementById("roller-top")!;
  const rollerBottom = document.getElementById("roller-bottom")!;

  const topWords = ["code", "logic", "design", "craft", "pixels"];
  const bottomWords = ["cinema", "motion", "vision", "stories", "rhythm"];

  const slideDuration = 800;

  function setFixedWidth(roller: HTMLElement, words: string[]) {
    const measure = document.createElement("span");
    measure.style.visibility = "hidden";
    measure.style.position = "absolute";
    measure.style.whiteSpace = "nowrap";
    measure.style.font = window.getComputedStyle(roller).font;
    measure.style.fontStyle = "normal";
    measure.style.letterSpacing = "0.02em";
    roller.appendChild(measure);

    let maxW = 0;
    for (const w of words) {
      measure.textContent = w;
      maxW = Math.max(maxW, measure.offsetWidth);
    }
    measure.remove();
    roller.style.width = `${maxW + 8}px`;
  }

  setFixedWidth(rollerTop, topWords);
  setFixedWidth(rollerBottom, bottomWords);

  function slideWord(roller: HTMLElement, newText: string): Promise<void> {
    return new Promise((resolve) => {
      const current = roller.querySelector(".roller-current") as HTMLElement;
      if (!current) { resolve(); return; }

      const next = document.createElement("span");
      next.className = "roller-next";
      next.textContent = newText;
      roller.appendChild(next);

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          current.classList.add("roller-out");
          next.classList.add("roller-in");
        });
      });

      setTimeout(() => {
        current.remove();
        next.className = "roller-current";
        resolve();
      }, slideDuration);
    });
  }

  async function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  async function loop() {
    let iTop = 1;
    let iBottom = 1;
    let flipTop = true;

    while (true) {
      if (flipTop) {
        await slideWord(rollerTop, topWords[iTop % topWords.length]);
        iTop++;
      } else {
        await slideWord(rollerBottom, bottomWords[iBottom % bottomWords.length]);
        iBottom++;
      }
      flipTop = !flipTop;
      await sleep(2000);
    }
  }

  loop();
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 18vh;
    overflow: hidden;
  }

  /* ── Floating shapes ── */
  .hero-shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .shape {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    opacity: 1;
    --mx: 0px;
    --my: 0px;
    translate: var(--mx) var(--my);
    will-change: translate;
  }

  :global(html.dark) .shape {
    border-color: rgba(255, 255, 255, 0.15);
    opacity: 1;
  }

  .shape--1 {
    width: 320px;
    height: 320px;
    top: 10%;
    left: 8%;
    border-radius: 50%;
    animation: float-1 14s ease-in-out infinite;
  }

  .shape--2 {
    width: 180px;
    height: 180px;
    top: 55%;
    right: 12%;
    border-radius: 40%;
    animation: float-2 11s ease-in-out infinite;
  }

  .shape--3 {
    width: 100px;
    height: 100px;
    bottom: 18%;
    left: 20%;
    border-radius: 30%;
    animation: float-3 13s ease-in-out infinite;
  }

  .shape--4 {
    width: 240px;
    height: 240px;
    top: 15%;
    right: 20%;
    border-radius: 50%;
    animation: float-4 16s ease-in-out infinite;
  }

  .shape--5 {
    width: 70px;
    height: 70px;
    bottom: 30%;
    right: 35%;
    border-radius: 35%;
    animation: float-5 10s ease-in-out infinite;
  }

  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(30px, -20px) rotate(8deg); }
    50% { transform: translate(-15px, 25px) rotate(-5deg); }
    75% { transform: translate(20px, 10px) rotate(3deg); }
  }

  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(-25px, 15px) rotate(-10deg); }
    66% { transform: translate(20px, -30px) rotate(6deg); }
  }

  @keyframes float-3 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    30% { transform: translate(15px, -25px) rotate(12deg); }
    60% { transform: translate(-20px, 10px) rotate(-8deg); }
  }

  @keyframes float-4 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    20% { transform: translate(-20px, -15px) rotate(-4deg); }
    50% { transform: translate(25px, 20px) rotate(7deg); }
    80% { transform: translate(-10px, -25px) rotate(-3deg); }
  }

  @keyframes float-5 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    40% { transform: translate(20px, 20px) rotate(15deg); }
    70% { transform: translate(-15px, -10px) rotate(-10deg); }
  }

  /* ── Content ── */
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 100;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    color: #3a3a3a;
    margin: 0;
    min-height: 2.6em;
  }

  :global(html.dark) .hero-title {
    color: #c8c8c8;
  }

  .hero-roller {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: bottom;
    height: 1.3em;
    text-align: center;
    font-family: "Space Grotesk", sans-serif;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, #1d4ed8, #3b82f6, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(html.dark) .hero-roller {
    background: linear-gradient(135deg, #60a5fa, #38bdf8, #22d3ee);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-roller :global(.roller-current) {
    display: inline-block;
    width: 100%;
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s ease;
  }

  .hero-roller :global(.roller-next) {
    display: inline-block;
    width: 100%;
    position: absolute;
    left: 0;
    top: 0;
    transform: translateY(110%);
    opacity: 0;
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s ease;
  }

  .hero-roller :global(.roller-next.roller-in) {
    transform: translateY(0);
    opacity: 1;
  }

  .hero-roller :global(.roller-current.roller-out) {
    transform: translateY(-110%);
    opacity: 0;
  }
</style>
