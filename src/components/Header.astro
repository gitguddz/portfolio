---
import { Icon } from "astro-icon/components";
---

<header
  class="sticky top-0 z-40 border-b border-transparent transition duration-200 ease-in-out w-full px-6 relative flex justify-between items-center"
>
    <div class="flex shrink-0 items-center min-w-0">
      <a href="/" class="flex items-center gap-2">
        <span class="font-bold">Sabri Akbas</span>
      </a>
    </div>
    <nav class="hidden md:flex items-center">
      <ul class="flex h-full items-center gap-6">
        <li>
          <a href="#home" class="nav-link">Home</a>
        </li>
        <li>
          <a href="#about" class="nav-link">About</a>
        </li>
        <li>
          <a href="#projects" class="nav-link">Projects</a>
        </li>
        <li>
          <a href="#contact" class="nav-link">Contact</a>
        </li>
      </ul>
    </nav>
    <div class="flex justify-end items-center min-w-0">
      <!-- Hamburger (mobile only) -->
      <button
        class="hamburger-btn md:hidden"
        id="hamburger-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" size={24} />
      </button>
      <!-- Gear trigger -->
      <button
        class="settings-btn"
        id="settings-btn"
        aria-label="Settings"
        aria-expanded="false"
      >
        <Icon name="lucide:settings" size={24} />
      </button>
      <!-- Settings panel -->
      <div class="settings-panel" id="settings-panel">
        <!-- Language -->
        <div class="panel-section">
          <div class="section-label">Language</div>
          <div class="lang-chips">
            <button class="chip" data-lang="en">EN</button>
            <button class="chip" data-lang="it">IT</button>
            <button class="chip" data-lang="de">DE</button>
            <button class="chip" data-lang="fr">FR</button>
          </div>
        </div>
        <div class="divider"></div>
        <!-- Theme -->
        <div class="panel-section">
          <div class="section-label">
            <span class="theme-icon theme-icon--sun"
              ><Icon name="lucide:sun" size={13} /></span
            >
            <span class="theme-icon theme-icon--moon"
              ><Icon name="lucide:moon" size={13} /></span
            >
            <span id="theme-label">Light</span>
          </div>
          <button
            class="toggle"
            id="theme-toggle"
            aria-label="Toggle dark mode"
          >
            <span class="toggle-thumb"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile nav dropdown -->
    <nav class="mobile-nav md:hidden" id="mobile-nav">
      <ul class="mobile-nav-list">
        <li><a href="#home" class="mobile-nav-link">Home</a></li>
        <li><a href="#about" class="mobile-nav-link">About</a></li>
        <li><a href="#projects" class="mobile-nav-link">Projects</a></li>
        <li><a href="#contact" class="mobile-nav-link">Contact</a></li>
      </ul>
    </nav>
</header>
<script>
  // ── Elements ──────────────────────────────────────────────────────
  const hamburgerBtn = document.getElementById("hamburger-btn")!;
  const mobileNav = document.getElementById("mobile-nav")!;
  const settingsBtn = document.getElementById("settings-btn")!;
  const settingsPanel = document.getElementById("settings-panel")!;
  const themeToggle = document.getElementById("theme-toggle")!;
  const themeLabel = document.getElementById("theme-label")!;
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");

  // ── Mobile menu ────────────────────────────────────────────────────
  let mobileNavClosing = false;

  function openMobileNav() {
    mobileNav.classList.add("open");
    hamburgerBtn.setAttribute("aria-expanded", "true");
  }

  function closeMobileNav() {
    if (mobileNavClosing) return;
    mobileNavClosing = true;
    mobileNav.classList.add("closing");

    const totalDelay = 220 + 300 + 80;
    setTimeout(() => {
      mobileNav.classList.remove("open", "closing");
      hamburgerBtn.setAttribute("aria-expanded", "false");
      mobileNavClosing = false;
    }, totalDelay);
  }

  hamburgerBtn.addEventListener("click", () => {
    if (mobileNav.classList.contains("open")) {
      closeMobileNav();
    } else {
      openMobileNav();
    }
  });

  mobileNav.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMobileNav());
  });

  // ── Panel open / close ────────────────────────────────────────────
  settingsBtn.addEventListener("click", () => {
    const open = settingsPanel.classList.toggle("open");
    settingsBtn.setAttribute("aria-expanded", String(open));
  });

  document.addEventListener("click", (e) => {
    if (
      !settingsBtn.contains(e.target as Node) &&
      !settingsPanel.contains(e.target as Node)
    ) {
      settingsPanel.classList.remove("open");
      settingsBtn.setAttribute("aria-expanded", "false");
    }
    if (
      !hamburgerBtn.contains(e.target as Node) &&
      !mobileNav.contains(e.target as Node) &&
      mobileNav.classList.contains("open")
    ) {
      closeMobileNav();
    }
  });

  // ── Language ──────────────────────────────────────────────────────
  function applyLang(lang: string, dispatch: boolean) {
    chips.forEach((c) => c.classList.toggle("active", c.dataset.lang === lang));
    localStorage.setItem("lang", lang);
    document.documentElement.lang = lang;
    if (dispatch)
      window.dispatchEvent(
        new CustomEvent("lang-change", { detail: { lang } }),
      );
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => applyLang(chip.dataset.lang!, true));
  });

  applyLang(localStorage.getItem("lang") ?? "en", false);

  // ── Dark mode ─────────────────────────────────────────────────────
  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    themeToggle.classList.toggle("on", dark);
    themeLabel.textContent = dark ? "Dark" : "Light";
    localStorage.setItem("theme", dark ? "dark" : "light");
  }

  themeToggle.addEventListener("click", () => {
    applyTheme(!document.documentElement.classList.contains("dark"));
  });

  // Restore saved theme (or system preference)
  const savedTheme = localStorage.getItem("theme");
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  applyTheme(savedTheme ? savedTheme === "dark" : prefersDark);
</script>

<style>
  /* ── Hamburger button (mobile) ── */
  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    color: var(--fg);
    background: none;
    border: none;
    transition: opacity 0.15s;
  }

  .hamburger-btn:hover {
    opacity: 1;
  }

  .hamburger-btn[aria-expanded="true"] {
    opacity: 1;
  }

  /* ── Mobile nav ── */
  .mobile-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
    box-shadow: 0 8px 24px var(--shadow);
    overflow: hidden;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
    pointer-events: none;
  }

  .mobile-nav.open {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav.closing {
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
    transition:
      grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1) 0.24s,
      opacity 0.3s ease 0.24s;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .mobile-nav.open .mobile-nav-list {
    padding: 0.5rem 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1.5rem;
    color: var(--fg);
    text-decoration: none;
    font-size: 0.95rem;
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.12s;
  }

  /* Opening: staggered top to bottom */
  .mobile-nav.open .mobile-nav-link {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-nav.open li:nth-child(1) .mobile-nav-link { transition-delay: 0.04s; }
  .mobile-nav.open li:nth-child(2) .mobile-nav-link { transition-delay: 0.1s; }
  .mobile-nav.open li:nth-child(3) .mobile-nav-link { transition-delay: 0.16s; }
  .mobile-nav.open li:nth-child(4) .mobile-nav-link { transition-delay: 0.22s; }

  /* Closing: staggered bottom to top (mirror of opening) */
  .mobile-nav.closing .mobile-nav-link {
    opacity: 0;
    transform: translateX(-10px);
  }

  .mobile-nav.closing li:nth-child(4) .mobile-nav-link { transition-delay: 0.04s; }
  .mobile-nav.closing li:nth-child(3) .mobile-nav-link { transition-delay: 0.1s; }
  .mobile-nav.closing li:nth-child(2) .mobile-nav-link { transition-delay: 0.16s; }
  .mobile-nav.closing li:nth-child(1) .mobile-nav-link { transition-delay: 0.22s; }

  .mobile-nav-link:hover {
    background: var(--border);
  }

  /* ── Gear button ── */
  .settings-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    color: var(--fg);
    transition:
      background 0.15s,
      transform 0.3s,
      opacity 0.15s;
  }

  .settings-btn:hover {
    opacity: 1;
  }

  .settings-btn[aria-expanded="true"] {
    transform: rotate(60deg);
    opacity: 1;
  }

  /* ── Panel ── */
  .settings-panel {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    /* Full-width on small screens, fixed on larger */
    width: calc(100vw - 2rem);
    max-width: 220px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 24px var(--shadow);
    padding: 0.5rem 0;
    animation: pop-in 0.15s ease;
  }

  .settings-panel.open {
    display: block;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ── Sections ── */
  .panel-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    gap: 0.5rem;
    min-height: 44px;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 0.2rem 0;
  }

  /* ── Language chips ── */
  .lang-chips {
    display: flex;
    gap: 0.25rem;
  }

  .chip {
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-size: 0.65rem;
    cursor: pointer;
    background: transparent;
    color: var(--fg);
    transition:
      background 0.12s,
      border-color 0.12s;
  }

  .chip:hover {
    background: var(--border);
  }
  .chip.active {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  /* ── Theme icon swap ── */
  .theme-icon {
    display: flex;
    align-items: center;
  }
  .theme-icon--moon {
    display: none;
  }

  :global(html.dark) .theme-icon--sun {
    display: none;
  }
  :global(html.dark) .theme-icon--moon {
    display: flex;
  }

  /* ── Theme toggle ── */
  .toggle {
    position: relative;
    width: 36px;
    height: 20px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--border);
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
    flex-shrink: 0;
  }

  .toggle.on {
    background: var(--fg);
    border-color: var(--fg);
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    transition: transform 0.2s;
  }

  .toggle.on .toggle-thumb {
    transform: translateX(16px);
  }
</style>
