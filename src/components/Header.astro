---
import { Icon } from "astro-icon/components";
import translations from "../i18n/translations";
---

<script is:inline define:vars={{ translations }}>
  window.__navTranslations = translations;
</script>

<header
  class="sticky top-0 z-40 border-b border-transparent transition duration-200 ease-in-out w-full px-6 pt-4 pb-2 relative flex justify-between items-center"
>
    <div class="flex shrink-0 items-center min-w-0">
      <a href="/" class="flex items-center gap-2">
        <span>Sabri Akbas</span>
      </a>
    </div>
    <nav class="hidden md:flex items-center">
      <ul class="flex h-full items-center gap-6">
        <li>
          <a href="#home" class="nav-link" data-nav-i18n="nav.home">Home</a>
        </li>
        <li>
          <a href="#about" class="nav-link" data-nav-i18n="nav.about">About</a>
        </li>
        <li>
          <a href="#projects" class="nav-link" data-nav-i18n="nav.projects">Projects</a>
        </li>
        <li>
          <a href="#contact" class="nav-link" data-nav-i18n="nav.contact">Contact</a>
        </li>
      </ul>
    </nav>
    <div class="flex justify-end items-center min-w-0 gap-3">
      <!-- Desktop: inline lang + theme -->
      <div class="nav-controls">
        <div class="lang-chips">
          <button class="chip" data-lang="it">IT</button>
          <button class="chip" data-lang="en">EN</button>
        </div>
        <button
          class="theme-btn"
          id="theme-toggle"
          aria-label="Toggle dark mode"
        >
          <span class="theme-icon theme-icon--sun"><Icon name="lucide:sun" size={18} /></span>
          <span class="theme-icon theme-icon--moon"><Icon name="lucide:moon" size={18} /></span>
        </button>
      </div>
      <!-- Mobile: hamburger + settings -->
      <div class="settings-wrap">
        <button
          class="settings-btn"
          id="settings-btn"
          aria-label="Settings"
          aria-expanded="false"
        >
          <Icon name="lucide:settings" size={22} />
        </button>
        <!-- Settings panel (mobile only) -->
        <div class="settings-panel" id="settings-panel">
          <button class="chip" data-lang="en">EN</button>
          <button class="chip" data-lang="it">IT</button>
          <button
            class="theme-btn"
            id="mobile-theme-toggle"
            aria-label="Toggle dark mode"
          >
            <span class="theme-icon theme-icon--sun"><Icon name="lucide:sun" size={18} /></span>
            <span class="theme-icon theme-icon--moon"><Icon name="lucide:moon" size={18} /></span>
          </button>
        </div>
      </div>
      <button
        class="hamburger-btn"
        id="hamburger-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" size={24} />
      </button>
    </div>

    <!-- Mobile nav dropdown -->
    <nav class="mobile-nav" id="mobile-nav">
      <ul class="mobile-nav-list">
        <li><a href="#home" class="mobile-nav-link" data-nav-i18n="nav.home">Home</a></li>
        <li><a href="#about" class="mobile-nav-link" data-nav-i18n="nav.about">About</a></li>
        <li><a href="#projects" class="mobile-nav-link" data-nav-i18n="nav.projects">Projects</a></li>
        <li><a href="#contact" class="mobile-nav-link" data-nav-i18n="nav.contact">Contact</a></li>
        <li><a href="/cv_en.pdf" download target="_blank" class="mobile-nav-link cv-download" data-nav-i18n="nav.cv">CV</a></li>
      </ul>
    </nav>
</header>
<script>
  // ── Nav i18n ──────────────────────────────────────────────────────
  const navTr = (window as any).__navTranslations as Record<string, Record<string, string>>;

  function applyNavLang() {
    const lang = document.documentElement.lang || "en";
    document.querySelectorAll<HTMLElement>("[data-nav-i18n]").forEach((el) => {
      const key = el.dataset.navI18n!;
      el.textContent = navTr[lang]?.[key] ?? navTr["en"][key] ?? key;
    });
  }

  applyNavLang();
  window.addEventListener("lang-change", () => applyNavLang());

  // ── Elements ──────────────────────────────────────────────────────
  const hamburgerBtn = document.getElementById("hamburger-btn")!;
  const mobileNav = document.getElementById("mobile-nav")!;
  const settingsBtn = document.getElementById("settings-btn")!;
  const settingsPanel = document.getElementById("settings-panel")!;
  const themeToggle = document.getElementById("theme-toggle")!;
  const mobileThemeToggle = document.getElementById("mobile-theme-toggle")!;
  const themeLabel = document.getElementById("theme-label");
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");

  // ── Mobile menu ────────────────────────────────────────────────────
  let mobileNavClosing = false;

  function openMobileNav() {
    mobileNav.classList.add("open");
    hamburgerBtn.setAttribute("aria-expanded", "true");
  }

  function closeMobileNav() {
    if (mobileNavClosing) return;
    mobileNavClosing = true;
    mobileNav.classList.add("closing");

    const totalDelay = 220 + 300 + 80;
    setTimeout(() => {
      mobileNav.classList.remove("open", "closing");
      hamburgerBtn.setAttribute("aria-expanded", "false");
      mobileNavClosing = false;
    }, totalDelay);
  }

  hamburgerBtn.addEventListener("click", () => {
    if (mobileNav.classList.contains("open")) {
      closeMobileNav();
    } else {
      openMobileNav();
    }
  });

  mobileNav.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMobileNav());
  });

  // ── Panel open / close ────────────────────────────────────────────
  settingsBtn.addEventListener("click", () => {
    const open = settingsPanel.classList.toggle("open");
    settingsBtn.setAttribute("aria-expanded", String(open));
  });

  document.addEventListener("click", (e) => {
    if (
      !settingsBtn.contains(e.target as Node) &&
      !settingsPanel.contains(e.target as Node)
    ) {
      settingsPanel.classList.remove("open");
      settingsBtn.setAttribute("aria-expanded", "false");
    }
    if (
      !hamburgerBtn.contains(e.target as Node) &&
      !mobileNav.contains(e.target as Node) &&
      mobileNav.classList.contains("open")
    ) {
      closeMobileNav();
    }
  });

  // ── Language ──────────────────────────────────────────────────────
  function applyLang(lang: string, reload: boolean) {
    chips.forEach((c) => c.classList.toggle("active", c.dataset.lang === lang));
    localStorage.setItem("lang", lang);
    document.documentElement.lang = lang;
    if (reload) {
      sessionStorage.setItem("skip-intro", "1");
      window.location.reload();
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => applyLang(chip.dataset.lang!, true));
  });

  applyLang(localStorage.getItem("lang") ?? "en", false);

  // ── CV download link per language ─────────────────────────────────
  const cvMap: Record<string, string> = { en: "/cv_en.pdf", it: "/cv_ita.pdf" };

  function updateCvLinks() {
    const lang = document.documentElement.lang || "en";
    const href = cvMap[lang] ?? cvMap["en"];
    document.querySelectorAll<HTMLAnchorElement>(".cv-download").forEach((a) => {
      a.href = href;
    });
  }

  updateCvLinks();

  // ── Dark mode ─────────────────────────────────────────────────────
  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    if (themeLabel) themeLabel.textContent = dark ? "Dark" : "Light";
    localStorage.setItem("theme", dark ? "dark" : "light");
  }

  function toggleTheme() {
    applyTheme(!document.documentElement.classList.contains("dark"));
  }

  themeToggle.addEventListener("click", toggleTheme);
  mobileThemeToggle.addEventListener("click", toggleTheme);

  const savedTheme = localStorage.getItem("theme");
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  applyTheme(savedTheme ? savedTheme === "dark" : prefersDark);
</script>

<style>
  /* ── Hamburger button (mobile) ── */
  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    color: var(--muted);
    background: none;
    border: none;
    transition: color 0.2s;
  }

  .hamburger-btn:hover,
  .hamburger-btn[aria-expanded="true"] {
    color: var(--fg);
  }

  /* ── Mobile nav ── */
  .mobile-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: transparent;
    border-top: none;
    box-shadow: none;
    overflow: hidden;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
    pointer-events: none;
  }

  .mobile-nav.open {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav.closing {
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
    transition:
      grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1) 0.24s,
      opacity 0.3s ease 0.24s;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .mobile-nav.open .mobile-nav-list {
    padding: 0.5rem 0;
  }

  .mobile-nav-list {
    text-align: right;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateX(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.2s;
  }

  /* Opening: staggered top to bottom */
  .mobile-nav.open .mobile-nav-link {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-nav.open li:nth-child(1) .mobile-nav-link { transition-delay: 0.04s; }
  .mobile-nav.open li:nth-child(2) .mobile-nav-link { transition-delay: 0.1s; }
  .mobile-nav.open li:nth-child(3) .mobile-nav-link { transition-delay: 0.16s; }
  .mobile-nav.open li:nth-child(4) .mobile-nav-link { transition-delay: 0.22s; }

  /* Closing: staggered bottom to top (mirror of opening) */
  .mobile-nav.closing .mobile-nav-link {
    opacity: 0;
    transform: translateX(10px);
  }

  .mobile-nav.closing li:nth-child(4) .mobile-nav-link { transition-delay: 0.04s; }
  .mobile-nav.closing li:nth-child(3) .mobile-nav-link { transition-delay: 0.1s; }
  .mobile-nav.closing li:nth-child(2) .mobile-nav-link { transition-delay: 0.16s; }
  .mobile-nav.closing li:nth-child(1) .mobile-nav-link { transition-delay: 0.22s; }

  .mobile-nav-link {
    color: var(--muted);
  }

  .mobile-nav-link:hover {
    color: var(--fg);
  }

  /* ── Nav links ── */
  .nav-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--fg);
  }

  /* ── Desktop nav controls ── */
  .nav-controls {
    display: none;
    align-items: center;
    gap: 1rem;
  }

  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }

  .theme-btn:hover {
    color: var(--fg);
  }

  @media (min-width: 768px) {
    .nav-controls {
      display: flex;
    }
    .hamburger-btn {
      display: none !important;
    }
    .settings-btn {
      display: none !important;
    }
    .settings-panel {
      display: none !important;
    }
    .mobile-nav {
      display: none !important;
    }
  }

  /* ── Gear button (mobile) ── */
  .settings-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    background: none;
    border: none;
    color: var(--muted);
    transition:
      color 0.2s,
      transform 0.3s;
  }

  .settings-btn:hover,
  .settings-btn[aria-expanded="true"] {
    color: var(--fg);
  }

  .settings-btn[aria-expanded="true"] {
    transform: rotate(60deg);
  }

  .settings-wrap {
    position: relative;
  }

  /* ── Panel ── */
  .settings-panel {
    display: none;
    flex-direction: column;
    align-items: center;
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    background: transparent;
    padding: 0.25rem 0;
    animation: pop-in 0.15s ease;
    gap: 0.25rem;
  }

  .settings-panel.open {
    display: flex;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ── Sections ── */
  .panel-section {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0.4rem 0.85rem;
    gap: 0.5rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .divider {
    height: 1px;
    background: transparent;
    margin: 0.1rem 0;
  }

  /* ── Language chips ── */
  .lang-chips {
    display: flex;
    gap: 0.15rem;
  }

  .chip {
    padding: 0.25rem 0.4rem;
    border: none;
    border-radius: 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    background: transparent;
    color: var(--muted);
    transition: color 0.2s;
  }

  .chip:hover {
    color: var(--fg);
  }

  .chip.active {
    color: var(--fg);
    font-weight: 500;
  }

  /* ── Theme icon swap ── */
  .theme-icon {
    display: flex;
    align-items: center;
  }
  .theme-icon--moon {
    display: none;
  }

  :global(html.dark) .theme-icon--sun {
    display: none;
  }
  :global(html.dark) .theme-icon--moon {
    display: flex;
  }

</style>
